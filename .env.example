# Environment Variables
# Copy this file to .env and fill in the actual values. DO NOT commit .env to version control!

# Portal Domain (End User)
PORTAL_URL=https://sydneyuniversity.knimbus.com
LIBRARY_NAME="[Name of the specific library, e.g., Sydney University]"

# Dashboard Domain (Admin)
DASHBOARD_URL=https://qa.knimbus.com

# Admin Credentials for Global Setup
ADMIN_USER=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Split Test User Credentials
STANDARD_USER_EMAIL=your_standard_user_email
STANDARD_USER_PASSWORD=your_standard_user_password

NEGATIVE_USER_EMAIL=your_negative_user_email
NEGATIVE_USER_PASSWORD=your_negative_user_password

OTP_USER_EMAIL=your_otp_user_email
OTP_USER_PASSWORD=your_otp_user_password

# ==========================================
# ADMIN UI TESTING TENANT (e.g. Codec Network)
# ==========================================
ADMIN_TEST_URL=https://qa.knimbus.com
ADMIN_TEST_EMAIL=codecnetwork@yopmail.com
ADMIN_TEST_PASSWORD=your_admin_test_password

TEST_TENANT_PORTAL_URL=https://codecnetwork.knimbus.com
TEST_TENANT_END_USER_1=your_first_user_email_id
TEST_TENANT_END_USER_1_PASSWORD=your_user_1_password
TEST_TENANT_END_USER_2=your_second_user_email_id
TEST_TENANT_END_USER_2_PASSWORD=your_user_2_password
TEST_TENANT_END_USER_3=your_third_user_email_id
TEST_TENANT_END_USER_3_PASSWORD=your_user_3_password

# T&C Specific User
TC_USER_EMAIL=your_tc_user_email
TC_USER_PASSWORD=your_tc_user_password

# User for Account Lock Scenarios
LOCKED_USER_EMAIL=your_locked_user_email
LOCKED_USER_PASSWORD=your_locked_user_password

MANDATORY_USER_EMAIL=your_mandatory_user_email
MANDATORY_USER_PASSWORD=your_mandatory_user_password
